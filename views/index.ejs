<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include("navbar.ejs") %>
    <h1>Welcome to the Message Board</h1>
    <hr>
    <% for(let i = 0; i < messages.length; i++){%>
        <div class="messagebox">
            <div>
                <div><%= `${messages[i].added.getDate()}-${messages[i].added.getMonth() + 1}-${messages[i].added.getFullYear()} ${messages[i].added.getHours()}:${messages[i].added.getMinutes()} ${messages[i].user}` %></div>
                <a href="message/<%= i + 1 %>">open</a>
            </div>
            <hr>
            <p><%= messages[i].text %></p>
        </div>
    <% } %>
</body>
</html>