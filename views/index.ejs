<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include("navbar.ejs") %>
    <main class="index">
        <h1>Welcome to the MBoard!</h1>
        <div class="messagebox">
            <% for(let i = 0; i < messages.length; i++){%>
                <% let d = messages[i].added %>
                <div class="message">
                    <div>
                        <div>
                            <h3><%= `${messages[i].name}` %></h3>
                            <p><%=`${d.toLocaleString('en-US', {month: 'short',day: 'numeric',year: 'numeric',hour: 'numeric',minute: '2-digit',hour12: true})}`%></p>
                        </div>
                        <a href="message/<%= messages[i].id %>"><img src="/output.svg" alt=""></a>
                    </div>
                    <hr>
                    <p><%= messages[i].text %></p>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>